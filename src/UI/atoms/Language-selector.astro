---
import LanguageIcon from '../../assets/icons/LanguageIcon.astro';

const currentLang = Astro.currentLocale || 'es';
const currentPath = Astro.url.pathname;
const pathWithoutLocale = currentPath.replace(/^\/(es|en)/, '') || '/';
const esHref = `/es${pathWithoutLocale === '/' ? '/' : pathWithoutLocale}`;
const enHref = `/en${pathWithoutLocale === '/' ? '/' : pathWithoutLocale}`;
const activeClass = 'bg-[#43CFF4]/50 rounded-md shadow-[4px_4px_18px_0px_#121427]';
const baseClass =
	'font-bold text-sm p-2 cursor-pointer hover:bg-[#43CFF4]/50 hover:rounded-md hover:shadow-[4px_4px_18px_0px_#121427] transition-colors duration-200';
---

<div class='flex items-center gap-2 bg-[#43CFF4]/10 backdrop-blur-sm border border-[#43CFF4]/20 text-[#DDF4FB] rounded-lg px-4 py-[5px]'>
	<LanguageIcon class='w-[24px] h-[24px]' />
	<a
		href={esHref}
		hreflang='es'
		data-i18n-switch
		aria-current={currentLang === 'es' ? 'page' : undefined}
		class:list={[baseClass, 'ms-3', currentLang === 'es' && activeClass]}
	>
		ES
	</a>
	<a
		href={enHref}
		hreflang='en'
		data-i18n-switch
		aria-current={currentLang === 'en' ? 'page' : undefined}
		class:list={[baseClass, currentLang === 'en' && activeClass]}
	>
		EN
	</a>
</div>
